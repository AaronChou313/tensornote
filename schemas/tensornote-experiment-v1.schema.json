{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensornote.app/schemas/tensornote-experiment-v1.schema.json",
  "title": "TensorNote Project Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experiment",
    "environments",
    "presets",
    "defaultPreset",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "workingDirectory"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "description": {
          "type": "string"
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "difficulty": {
          "enum": [
            "basic",
            "medium",
            "heavy"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memoryGB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diskGB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "optional": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "memoryGB": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "python",
          "files"
        ],
        "properties": {
          "python": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          },
          "extends": {
            "$ref": "#/$defs/id"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "enum",
              "path"
            ]
          },
          "label": {
            "$ref": "#/$defs/nonempty"
          },
          "default": {},
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "environment",
          "steps"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonempty"
          },
          "environment": {
            "$ref": "#/$defs/id"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "defaultPreset": {
      "$ref": "#/$defs/id"
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "runner"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonempty"
          },
          "runner": {
            "enum": [
              "python",
              "python-module",
              "notebook",
              "torchrun"
            ]
          },
          "file": {
            "$ref": "#/$defs/path"
          },
          "module": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            },
            "uniqueItems": true
          },
          "processes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "nodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "nodeRank": {
            "type": "integer",
            "minimum": 0
          },
          "masterAddress": {
            "type": "string",
            "minLength": 1
          },
          "masterPort": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        },
        "oneOf": [
          {
            "required": [
              "file"
            ],
            "not": {
              "required": [
                "module"
              ]
            }
          },
          {
            "required": [
              "module"
            ],
            "not": {
              "required": [
                "file"
              ]
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "path",
          "kind"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonempty"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "enum": [
              "file",
              "directory",
              "image",
              "json",
              "csv",
              "markdown",
              "notebook",
              "model"
            ]
          }
        }
      }
    },
    "downloads": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "cache"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonempty"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sizeMB": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cache": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "license": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
