{
  "name": "tensornote",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local-first, Markdown-first executable knowledge workspace.",
  "homepage": "https://github.com/AaronChou313/tensornote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronChou313/tensornote.git"
  },
  "bugs": {
    "url": "https://github.com/AaronChou313/tensornote/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "jupyter",
    "notebook",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop:web": "vite --mode desktop",
    "dev:desktop": "tauri dev",
    "git:bridge": "node scripts/git-bridge.mjs",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode static && node scripts/verify-static-boundary.mjs",
    "build:desktop:web": "tsc -b && vite build --mode desktop",
    "build:desktop": "tauri build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:performance": "vitest run src/performance/workspacePerformance.test.ts",
    "check": "pnpm test && pnpm lint && pnpm build",
    "check:desktop": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/view": "^6.43.9",
    "@jupyterlab/services": "^7.4.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "2.11.1",
    "@uiw/react-codemirror": "^4.25.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "mermaid": "^11.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
